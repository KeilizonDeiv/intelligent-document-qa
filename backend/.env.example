# Anthropic API key (required for full Claude-generated answers; omit to run in demo mode)
ANTHROPIC_API_KEY=your_api_key_here

# Models (see https://docs.anthropic.com for current model IDs)
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_REWRITE_MODEL=claude-haiku-4-5

# Document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=10

# Storage
UPLOAD_DIR=./uploads
VECTOR_DB_PATH=./vector_db

# CORS (comma-separated origins allowed to call this API)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LOG_LEVEL=INFO
